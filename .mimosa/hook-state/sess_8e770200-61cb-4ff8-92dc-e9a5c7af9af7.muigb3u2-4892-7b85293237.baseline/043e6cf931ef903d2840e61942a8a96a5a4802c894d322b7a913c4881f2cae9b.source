import re
import unittest
from io import BytesIO
from unittest.mock import patch

import numpy as np
from PIL import Image

from scripts.t04_web import create_poc_app


class T04WebPocTests(unittest.TestCase):
    def setUp(self):
        self.app = create_poc_app("kode-uji", testing=True)
        self.client = self.app.test_client()

    @staticmethod
    def csrf(response):
        match = re.search(r'data-csrf="([^"]+)"', response.get_data(as_text=True))
        assert match
        return match.group(1)

    def test_unlock_starts_isolated_session_and_reset_does_not_touch_database(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        self.assertEqual(
            self.client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"}).status_code,
            302,
        )
        active = self.client.get("/")
        self.assertIn("Nyalakan kamera", active.get_data(as_text=True))
        active_token = self.csrf(active)
        reset = self.client.post("/api/reset", headers={"X-CSRF-Token": active_token})
        self.assertEqual(reset.status_code, 200)
        self.assertEqual(reset.get_json()["poses"], [])

    def test_invalid_code_and_expired_session_are_rejected(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        self.assertEqual(
            self.client.post("/unlock", data={"csrf_token": token, "access_code": "salah"}).status_code,
            403,
        )
        self.assertEqual(
            self.client.post("/api/reset", headers={"X-CSRF-Token": token}).status_code,
            401,
        )

    def test_end_deletes_session_and_prevents_reuse(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        self.client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"})
        active_token = self.csrf(self.client.get("/"))
        self.assertEqual(self.client.post("/api/end", headers={"X-CSRF-Token": active_token}).status_code, 200)
        self.assertEqual(self.client.post("/api/reset", headers={"X-CSRF-Token": active_token}).status_code, 401)

    def test_large_valid_jpeg_upload_is_below_one_mib_and_reaches_analysis(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        self.client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"})
        active_token = self.csrf(self.client.get("/"))
        pixels = np.random.default_rng(41).integers(0, 256, (480, 640, 3), dtype=np.uint8)
        jpeg = BytesIO()
        Image.fromarray(pixels).save(jpeg, format="JPEG", quality=90)
        self.assertGreater(jpeg.tell(), 200 * 1024)
        self.assertLess(jpeg.tell(), 1024 * 1024)
        jpeg.seek(0)
        with patch("scripts.t04_web.analyze_frame") as analyze:
            analyze.return_value = (np.zeros((40, 40, 3), dtype=np.uint8), {
                "quality_ok": True, "eye_count": 2,
            })
            response = self.client.post("/api/frame", data={
                "mode": "inspect", "frame": (jpeg, "frame.jpg", "image/jpeg"),
            }, headers={"X-CSRF-Token": active_token})
        self.assertEqual(response.status_code, 200, response.get_data(as_text=True))
        analyze.assert_called_once()

    def test_oversized_and_malformed_frame_are_rejected(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        self.client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"})
        active_token = self.csrf(self.client.get("/"))
        oversized = self.client.post("/api/frame", data={
            "mode": "inspect", "frame": (BytesIO(b"x" * (1024 * 1024)), "frame.jpg", "image/jpeg"),
        }, headers={"X-CSRF-Token": active_token})
        self.assertEqual(oversized.status_code, 413)
        malformed = self.client.post("/api/frame", data={
            "mode": "inspect", "frame": (BytesIO(b"not an image"), "frame.jpg", "image/jpeg"),
        }, headers={"X-CSRF-Token": active_token})
        self.assertEqual(malformed.status_code, 422)

    def test_unicode_csrf_and_access_code_are_rejected_without_server_error(self):
        landing = self.client.get("/")
        token = self.csrf(landing)
        unicode_csrf = self.client.post("/unlock", data={
            "csrf_token": "token-uji-☃", "access_code": "kode-uji",
        })
        self.assertEqual(unicode_csrf.status_code, 400)
        unicode_code = self.client.post("/unlock", data={
            "csrf_token": token, "access_code": "kode-uji-☃",
        })
        self.assertEqual(unicode_code.status_code, 403)

    def test_each_browser_session_keeps_samples_isolated(self):
        first = self.client
        first_token = self.csrf(first.get("/"))
        first.post("/unlock", data={"csrf_token": first_token, "access_code": "kode-uji"})
        with first.session_transaction() as state:
            first_session = state["experiment"]
        self.app.extensions["t04_experiments"][first_session].samples["front"] = np.ones((20, 20))

        second = self.app.test_client()
        second_token = self.csrf(second.get("/"))
        second.post("/unlock", data={"csrf_token": second_token, "access_code": "kode-uji"})
        with second.session_transaction() as state:
            second_session = state["experiment"]
        self.assertNotEqual(first_session, second_session)
        self.assertEqual(self.app.extensions["t04_experiments"][second_session].samples, {})
        self.assertEqual(first.get("/").status_code, 200)
        self.assertEqual(second.get("/").status_code, 200)

    def test_public_mode_explains_cloudflare_frame_route(self):
        public_app = create_poc_app("kode-uji", public_tunnel=True, testing=True)
        client = public_app.test_client()
        landing = client.get("/")
        token = self.csrf(landing)
        client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"})
        page = client.get("/").get_data(as_text=True)
        self.assertIn("Frame wajah dikirim melalui jaringan Cloudflare", page)
        self.assertIn("setujui penggunaan data", page)

    def test_three_pose_capture_and_new_face_prediction_flow(self):
        token = self.csrf(self.client.get("/"))
        self.client.post("/unlock", data={"csrf_token": token, "access_code": "kode-uji"})
        token = self.csrf(self.client.get("/"))
        captures = [np.full((200, 200, 3), value, dtype=np.uint8) for value in (70, 120, 180, 130)]
        reports = {"quality_ok": True, "eye_count": 2}
        with patch("scripts.t04_web.analyze_frame", side_effect=[
            (image, reports.copy()) for image in captures
        ]):
            for pose in ("front", "left", "right"):
                response = self.client.post("/api/frame", data={
                    "mode": "capture", "pose": pose,
                    "frame": (BytesIO(b"frame"), "frame.jpg", "image/jpeg"),
                }, headers={"X-CSRF-Token": token})
                self.assertEqual(response.status_code, 200, response.get_data(as_text=True))
            self.assertTrue(response.get_json()["model_ready"])
            prediction = self.client.post("/api/frame", data={
                "mode": "predict", "frame": (BytesIO(b"frame"), "frame.jpg", "image/jpeg"),
            }, headers={"X-CSRF-Token": token})
        self.assertEqual(prediction.status_code, 200, prediction.get_data(as_text=True))
        self.assertIsInstance(prediction.get_json()["distance"], float)


if __name__ == "__main__":
    unittest.main()
