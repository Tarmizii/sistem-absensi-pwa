"""Student-owned enrollment preparation page for T14."""

from __future__ import annotations

from flask import Blueprint, abort, g, jsonify, redirect, render_template, request, url_for
from pymysql import MySQLError

from app.services.auth_service import roles_required
from app.services.attendance_read_service import (
    AttendanceReadError,
    get_student_month_history,
)
from app.services.attendance_state_service import get_student_day_state
from app.services.schedule_service import application_now
from app.services.enrollment_service import (
    StudentEnrollmentNotFoundError,
    get_own_enrollment_progress,
)


student_bp = Blueprint("student", __name__)


def _reject_identity_override():
    if "student_id" in request.args or "user_id" in request.args:
        return jsonify(error="Identitas Siswa ditentukan dari sesi login."), 400
    return None


@student_bp.get("/student/attendance-state")
@roles_required("student")
def attendance_state():
    invalid = _reject_identity_override()
    if invalid:
        return invalid
    try:
        state = get_student_day_state(g.current_user["id"])
    except LookupError:
        return jsonify(error="Profil Siswa tidak ditemukan."), 404
    except MySQLError:
        return jsonify(error="Status presensi belum dapat dimuat."), 503
    schedule = state.get("schedule")
    return jsonify({
        "full_name": state["full_name"], "class_name": state["class_name"],
        "today": state["today"], "server_time": state["server_time"],
        "status_today": state["status_today"],
        "status_source_label": state["status_source_label"],
        "checkin_time": state["checkin_time"], "checkout_time": state["checkout_time"],
        "state": state["state"], "cta_label": state["cta_label"],
        "cta_enabled": state["cta_enabled"], "reason": state["reason"],
        "predicted_status": state.get("predicted_status"),
        "schedule": ({
            key: schedule.get(key) for key in (
                "checkin_start", "late_after", "checkin_cutoff", "checkout_start", "is_holiday"
            )
        } if schedule else None),
    })


@student_bp.get("/student/history")
@roles_required("student")
def attendance_history():
    invalid = _reject_identity_override()
    if invalid:
        return invalid
    try:
        history = get_student_month_history(
            g.current_user["id"],
            request.args.get("month") or application_now().strftime("%Y-%m"),
            request.args.get("date"),
        )
    except AttendanceReadError as error:
        return render_template("student/history.html", history=None,
                               error=str(error), error_status=error.status_code), error.status_code
    except LookupError:
        abort(404)
    except MySQLError:
        return render_template("student/history.html", history=None,
                               error="Riwayat belum dapat dimuat. Periksa koneksi lalu coba lagi.",
                               error_status=503), 503
    return render_template("student/history.html", history=history, error=None, error_status=200)


@student_bp.get("/student/enrollment")
@roles_required("student")
def enrollment():
    try:
        progress = get_own_enrollment_progress(g.current_user["id"])
    except StudentEnrollmentNotFoundError:
        abort(404)
    except MySQLError:
        return render_template("student/enrollment.html", progress=None,
                               database_unavailable=True), 503
    if progress["face_registered"]:
        return redirect(url_for("role.student_dashboard"))
    return render_template("student/enrollment.html", progress=progress,
                           database_unavailable=False)
