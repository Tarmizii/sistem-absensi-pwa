"""Isolated, in-memory T04 experiment. Never registers production routes or DB."""

from dataclasses import dataclass, field
from pathlib import Path
import secrets
from threading import RLock
import time

import cv2
from flask import Flask, jsonify, redirect, render_template, request, session
import numpy as np

from app.services import face_poc as face
from app.services.storage_service import StorageError, validate_camera_image

ROOT = Path(__file__).resolve().parents[1]
POSES = ("front", "left", "right")
TTL = 30 * 60


@dataclass
class Experiment:
    touched: float = field(default_factory=time.monotonic)
    samples: dict = field(default_factory=dict)
    model: object = None
    blink: object = field(default_factory=face.ProvisionalBlinkTracker)
    last_frame: float = 0


def analyze_frame(payload, mime):
    with validate_camera_image(payload, mime) as image:
        if max(image.size) > 960:
            raise face.FacePocError("Frame uji maksimal 960 piksel per sisi.")
        bgr = cv2.cvtColor(np.asarray(image), cv2.COLOR_RGB2BGR)
    x, y, w, h = face.detect_single_face(bgr)
    crop = bgr[y:y + h, x:x + w]
    quality = face.assess_image_quality(crop)
    return crop, {
        "face_count": 1,
        "brightness": round(quality.brightness, 2),
        "sharpness": round(quality.sharpness, 2),
        "quality_ok": quality.acceptable,
        "eye_count": face.detect_eye_count(crop),
    }


def create_poc_app(access_code, *, testing=False, public_tunnel=False):
    app = Flask(__name__, template_folder=str(ROOT / "app/templates"),
                static_folder=str(ROOT / "app/static"))
    app.config.update(SECRET_KEY=secrets.token_hex(32), TESTING=testing,
                      SESSION_COOKIE_NAME="t04_session", SESSION_COOKIE_SECURE=True,
                      SESSION_COOKIE_HTTPONLY=True, SESSION_COOKIE_SAMESITE="Strict",
                      MAX_CONTENT_LENGTH=1024 * 1024, MAX_FORM_MEMORY_SIZE=64 * 1024,
                      MAX_FORM_PARTS=8, PUBLIC_TUNNEL=public_tunnel)
    experiments = {}
    app.extensions["t04_experiments"] = experiments
    attempts = {}
    lock = RLock()

    def csrf():
        if "csrf" not in session:
            session["csrf"] = secrets.token_hex(24)
        return session["csrf"]

    @app.before_request
    def protect():
        if request.path.startswith("/api/"):
            with lock:
                now = time.monotonic()
                for key in list(experiments):
                    if now - experiments[key].touched >= TTL:
                        del experiments[key]
                experiment = experiments.get(session.get("experiment"))
                if experiment is None:
                    return jsonify(error="Sesi uji berakhir. Muat ulang dan masukkan kode akses."), 401
                experiment.touched = now
        if request.method == "POST":
            received = request.headers.get("X-CSRF-Token") or request.form.get("csrf_token", "")
            if (not isinstance(received, str) or not received.isascii()
                    or not session.get("csrf")
                    or not secrets.compare_digest(received, session["csrf"])):
                return jsonify(error="Sesi tidak valid. Muat ulang halaman."), 400

    @app.after_request
    def headers(response):
        response.headers.update({"Cache-Control": "no-store", "X-Content-Type-Options": "nosniff",
                                 "Referrer-Policy": "no-referrer", "X-Frame-Options": "DENY",
                                 "Permissions-Policy": "camera=(self), microphone=(), geolocation=()"})
        return response

    @app.errorhandler(413)
    def too_large(error):
        return jsonify(error="Frame terlalu besar. Gunakan kamera dari halaman uji."), 413

    @app.get("/")
    def index():
        with lock:
            experiment = experiments.get(session.get("experiment"))
            active = experiment is not None and time.monotonic() - experiment.touched < TTL
        return render_template("poc/t04.html", active=active, csrf=csrf())

    @app.post("/unlock")
    def unlock():
        now = time.monotonic()
        address = request.remote_addr
        with lock:
            for key in list(attempts):
                attempts[key] = [t for t in attempts[key] if now - t < 60]
                if not attempts[key]:
                    del attempts[key]
            recent = attempts.setdefault(address, [])
            if len(recent) >= 5 or len(attempts) > 100:
                return render_template("poc/t04.html", active=False, csrf=csrf(),
                                       error="Terlalu banyak percobaan. Tunggu satu menit."), 429
            submitted_code = request.form.get("access_code", "")
            if (not submitted_code.isascii()
                    or not secrets.compare_digest(submitted_code, access_code)):
                recent.append(now)
                return render_template("poc/t04.html", active=False, csrf=csrf(),
                                       error="Kode tidak sesuai. Lihat kode pada terminal laptop."), 403
            for key in list(experiments):
                if now - experiments[key].touched >= TTL or key == session.get("experiment"):
                    del experiments[key]
            if len(experiments) >= 4:
                return render_template("poc/t04.html", active=False, csrf=csrf(),
                                       error="Empat sesi sedang aktif. Akhiri sesi yang tidak dipakai."), 429
            session.clear()
            session["experiment"] = secrets.token_hex(24)
            experiments[session["experiment"]] = Experiment()
            csrf()
        return redirect("/")

    @app.post("/api/reset")
    def reset():
        with lock:
            experiments[session["experiment"]] = Experiment()
        return jsonify(message="Sampel dan model sementara sudah dihapus.", poses=[])

    @app.post("/api/end")
    def end():
        with lock:
            experiments.pop(session.get("experiment"), None)
            session.clear()
        return jsonify(message="Sesi diakhiri dan sampel dihapus.")

    @app.post("/api/frame")
    def frame():
        mode = request.form.get("mode", "inspect")
        pose = request.form.get("pose")
        if mode not in {"inspect", "capture", "predict"} or (mode == "capture" and pose not in POSES):
            return jsonify(error="Mode atau pose uji tidak valid."), 400
        uploaded = request.files.get("frame")
        if uploaded is None:
            return jsonify(error="Frame kamera belum tersedia."), 400
        with lock:
            experiment = experiments[session["experiment"]]
            now = time.monotonic()
            if now - experiment.last_frame > 2:
                experiment.blink = face.ProvisionalBlinkTracker()
            experiment.last_frame = now
            try:
                crop, report = analyze_frame(uploaded.read(), uploaded.mimetype)
                report["blink_signal"] = experiment.blink.observe(report["eye_count"])
                report["poses"] = list(experiment.samples)
                if mode in {"capture", "predict"} and not report["quality_ok"]:
                    return jsonify(**report, error="Kualitas belum cukup. Tambah cahaya dan tahan kamera stabil."), 422
                if mode == "capture":
                    # Pose is explicitly operator-labelled; Haar does not prove head direction.
                    proposed = {**experiment.samples, pose: crop.copy()}
                    model = None
                    if len(proposed) == 3:
                        model = face.train_lbph([proposed[p] for p in POSES], [1, 1, 1])
                    experiment.samples, experiment.model = proposed, model
                    report.update(poses=list(proposed), model_ready=model is not None,
                                  message="Sampel pose disimpan sementara.")
                elif mode == "predict":
                    if experiment.model is None:
                        return jsonify(error="Ambil tiga pose sebelum membandingkan wajah."), 409
                    _, distance = face.predict_lbph(experiment.model, crop)
                    report.update(distance=round(distance, 3),
                                  message="Distance tersedia; belum ada keputusan cocok/tidak cocok otomatis.")
                return jsonify(report)
            except (face.FacePocError, StorageError) as error:
                experiment.blink = face.ProvisionalBlinkTracker()
                return jsonify(error=str(error)), 422
            except cv2.error:
                experiment.blink = face.ProvisionalBlinkTracker()
                return jsonify(error="OpenCV gagal memproses frame. Coba ambil ulang."), 422

    return app
