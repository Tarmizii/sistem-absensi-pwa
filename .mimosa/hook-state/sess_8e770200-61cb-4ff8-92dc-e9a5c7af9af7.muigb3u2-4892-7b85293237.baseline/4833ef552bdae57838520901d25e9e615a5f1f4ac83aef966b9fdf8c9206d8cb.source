"""Minimal role-protected destinations used by T03 redirects."""

from __future__ import annotations

from flask import Blueprint, abort, g, redirect, render_template, request, url_for
from pymysql import MySQLError

from app.services.auth_service import login_required, roles_required
from app.services.attendance_read_service import (
    AttendanceReadError,
    get_student_profile,
    get_teacher_dashboard,
)


role_bp = Blueprint("role", __name__)


def render_profile(role: str, role_label: str, **extra):
    return render_template(
        "auth/profile.html",
        role=role,
        role_label=role_label,
        username=g.current_user["username"],
        is_active=bool(g.current_user["is_active"]),
        must_change_password=bool(g.current_user["must_change_password"]),
        **extra,
    )


@role_bp.get("/admin/dashboard")
@roles_required("admin")
def admin_dashboard():
    return render_template(
        "auth/role_dashboard.html",
        role_label="Admin",
        role="admin",
        username=g.current_user["username"],
    )


@role_bp.get("/teacher/dashboard")
@roles_required("teacher")
def teacher_dashboard():
    try:
        model = get_teacher_dashboard(g.current_user["id"], request.args.get("class_id"))
    except AttendanceReadError as error:
        abort(error.status_code, description=str(error))
    except MySQLError:
        return render_template(
            "teacher/error.html",
            retry_url=url_for("role.teacher_dashboard", **request.args),
        ), 503
    return render_template(
        "teacher/dashboard.html", model=model,
        username=g.current_user["username"],
    )


@role_bp.get("/student/dashboard")
@roles_required("student")
def student_dashboard():
    """Student home: today's state and the single attendance CTA (T17).

    The server derives eligibility; the template only renders it.
    """

    from pymysql import MySQLError

    from app.services.attendance_state_service import get_student_day_state

    try:
        state = get_student_day_state(g.current_user["id"])
    except LookupError:
        return render_template(
            "student/dashboard.html",
            state=None, username=g.current_user["username"],
            database_unavailable=False, not_found=True,
        ), 404
    except MySQLError:
        return render_template(
            "student/dashboard.html",
            state=None, username=g.current_user["username"],
            database_unavailable=True, not_found=False,
        ), 503
    return render_template(
        "student/dashboard.html",
        state=state, username=g.current_user["username"],
        database_unavailable=False, not_found=False,
    )


@role_bp.get("/admin/profile")
@roles_required("admin")
def admin_profile():
    return render_profile("admin", "Admin")


@role_bp.get("/teacher/profile")
@roles_required("teacher")
def teacher_profile():
    return render_profile("teacher", "Guru/Wali Kelas")


@role_bp.get("/student/profile")
@roles_required("student")
def student_profile():
    try:
        profile = get_student_profile(g.current_user["id"])
    except LookupError:
        return render_profile("student", "Siswa", student_profile=None,
                              profile_error="Profil Siswa tidak ditemukan."), 404
    except MySQLError:
        return render_profile("student", "Siswa", student_profile=None,
                              profile_error="Profil belum dapat dimuat. Periksa koneksi lalu coba lagi."), 503
    return render_profile("student", "Siswa", student_profile=profile, profile_error=None)


@role_bp.get("/profile")
@login_required
def profile_redirect():
    """Provide one safe shortcut while keeping role-specific profile URLs."""

    return redirect(url_for(f"role.{g.current_user['role']}_profile"))
