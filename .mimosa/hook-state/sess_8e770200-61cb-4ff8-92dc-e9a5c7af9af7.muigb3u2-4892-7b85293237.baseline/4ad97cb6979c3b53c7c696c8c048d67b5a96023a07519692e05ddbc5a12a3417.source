"""Atomic password/audit behavior and metadata privacy."""

import json
import unittest
from unittest.mock import MagicMock, patch

from werkzeug.security import check_password_hash, generate_password_hash

from app import create_app
from app.services.audit_service import record_audit
from app.services.auth_service import update_password, credential_stamp


class AuditTests(unittest.TestCase):
    def test_safe_metadata_is_parameterized(self):
        cursor = MagicMock(lastrowid=9)
        self.assertEqual(record_audit(cursor, actor_user_id=1, action="password_changed",
                                     target_type="user", target_id=1,
                                     metadata={"must_change_password": False}), 9)
        sql, params = cursor.execute.call_args.args
        self.assertIn("VALUES (%s", sql)
        self.assertEqual(params[:4], (1, "password_changed", "user", 1))
        self.assertEqual(json.loads(params[4]), {"must_change_password": False})
        self.assertIsNone(params[5].tzinfo)

    def test_manual_status_audit_keeps_only_enum_transition_not_the_note(self):
        cursor = MagicMock(lastrowid=10)
        record_audit(
            cursor, actor_user_id=5, action="attendance_manual_status_corrected",
            target_type="attendance_record", target_id=90,
            metadata={"previous_status": "absent", "status": "permit"},
        )
        params = cursor.execute.call_args.args[1]
        self.assertEqual(json.loads(params[4]), {"previous_status": "absent", "status": "permit"})
        cursor = MagicMock()
        with self.assertRaises(ValueError):
            record_audit(
                cursor, actor_user_id=5, action="attendance_manual_status_set",
                target_type="attendance_record", target_id=90,
                metadata={"status": "permit", "notes": "private reason"},
            )
        cursor.execute.assert_not_called()

    def test_secret_and_nested_metadata_rejected_without_query(self):
        for metadata in ({"password": "secret"}, {"password_hash": "hash"},
                         {"frame": "raw-biometrics"}, {"must_change_password": {"password": "secret"}}):
            cursor = MagicMock()
            with self.subTest(metadata=list(metadata)), self.assertRaises(ValueError):
                record_audit(cursor, actor_user_id=1, action="password_changed",
                             target_type="user", target_id=1, metadata=metadata)
            cursor.execute.assert_not_called()

    def test_unregistered_actions_and_bad_ids_rejected(self):
        for overrides in ({"action": "raw secret"}, {"target_id": True},
                          {"actor_user_id": -1}, {"target_type": "face"}):
            args = dict(actor_user_id=1, action="password_changed", target_type="user", target_id=1)
            args.update(overrides)
            with self.assertRaises(ValueError):
                record_audit(MagicMock(), **args)

    def test_password_and_audit_commit_together_and_return_new_binding(self):
        app = create_app({"TESTING": True, "SECRET_KEY": "audit-test"})
        connection = MagicMock()
        cursor = connection.cursor.return_value.__enter__.return_value
        cursor.rowcount = 1
        old = generate_password_hash("old-test-password")
        with app.app_context(), patch("app.database.get_db", return_value=connection):
            stamp = update_password(1, "new-test-password", old)
            sql, params = cursor.execute.call_args_list[0].args
            self.assertIn("AND password_hash = %s", sql)
            self.assertEqual(params[1:], (1, old))
            self.assertTrue(check_password_hash(params[0], "new-test-password"))
            self.assertEqual(stamp, credential_stamp(params[0]))
            self.assertIn("INSERT INTO audit_logs", cursor.execute.call_args_list[1].args[0])
        connection.commit.assert_called_once()
        connection.rollback.assert_not_called()

    def test_audit_failure_rolls_back_password_and_stale_update_is_rejected(self):
        app = create_app({"TESTING": True, "SECRET_KEY": "audit-test"})
        old = generate_password_hash("old-test-password")
        for rows, failure in ((1, RuntimeError("audit unavailable")), (0, None)):
            connection = MagicMock()
            cursor = connection.cursor.return_value.__enter__.return_value
            cursor.rowcount = rows
            with app.app_context(), patch("app.database.get_db", return_value=connection), \
                    patch("app.services.auth_service.record_audit", side_effect=failure) as audit:
                with self.assertRaises((RuntimeError, ValueError)):
                    update_password(1, "new-test-password", old)
                if rows == 0:
                    audit.assert_not_called()
            connection.commit.assert_not_called()
            connection.rollback.assert_called_once()
