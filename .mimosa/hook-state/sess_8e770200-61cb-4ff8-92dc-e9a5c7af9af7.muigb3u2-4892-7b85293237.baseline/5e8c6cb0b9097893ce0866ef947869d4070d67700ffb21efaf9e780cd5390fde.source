"""Private files with opaque server-generated keys; never a public file route.

Callers must authorize access before resolving a key from a database record.
Only the application OS account may write the root or its parent directories.
"""

from io import BytesIO
from pathlib import Path
import os
import re
import uuid

from flask import current_app
from PIL import Image, ImageOps, UnidentifiedImageError


MAX_IMAGE_BYTES = 5 * 1024 * 1024
MAX_IMAGE_PIXELS = 8_000_000
MAX_IMAGE_SIDE = 4096
MAX_MODEL_BYTES = 64 * 1024 * 1024
KEY_PATTERN = re.compile(r"(?:faces/[0-9a-f]{32}\.png|attendance/[0-9a-f]{32}\.webp|models/[0-9a-f]{32}\.yml)")


class StorageError(ValueError):
    """Invalid private file input (safe message without original payload/path)."""


def _private_root() -> Path:
    configured = Path(current_app.config["STORAGE_ROOT"])
    root = configured.resolve()
    public = Path(current_app.static_folder).resolve()
    if root == public or root.is_relative_to(public) or public.is_relative_to(root):
        raise StorageError("Storage privat harus terpisah dari folder static.")
    # Also reject junctions/symlinks resolving the configured root to static.
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    return root


def init_storage() -> None:
    root = _private_root()
    for category in ("faces", "attendance", "models"):
        directory = root / category
        if directory.is_symlink() or directory.resolve() != directory:
            raise StorageError("Folder storage tidak boleh berupa tautan.")
        directory.mkdir(exist_ok=True, mode=0o700)


def resolve_private_file(key: str) -> Path:
    """Resolve ONLY a server key fetched from an authorized database record."""
    if not isinstance(key, str) or not KEY_PATTERN.fullmatch(key):
        raise StorageError("Referensi berkas tidak valid.")
    root = _private_root()
    candidate = root / key
    if candidate.is_symlink() or candidate.resolve() != candidate:
        raise StorageError("Tautan berkas tidak diizinkan.")
    if not candidate.is_file():
        raise FileNotFoundError("Berkas privat tidak ditemukan.")
    return candidate


def _write(category: str, extension: str, payload: bytes) -> str:
    init_storage()
    root = _private_root()
    key = f"{category}/{uuid.uuid4().hex}.{extension}"
    destination = root / key
    # Exclusive creation prevents overwriting an existing file or following a
    # malicious destination link. Return the key only after a complete write.
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
    return key


def validate_camera_image(payload: bytes, mime_type: str) -> Image.Image:
    """Decode a bounded JPEG/PNG; return RGB pixels without attached metadata.

    These are transport limits, not face-quality/identity/liveness acceptance.
    Recognition must use these full-size pixels before evidence compression.
    """
    if not isinstance(payload, bytes) or not 0 < len(payload) <= MAX_IMAGE_BYTES:
        raise StorageError("Ukuran gambar harus 1 byte sampai 5 MiB.")
    formats = {"image/jpeg": "JPEG", "image/png": "PNG"}
    if mime_type not in formats:
        raise StorageError("Gambar harus JPEG atau PNG.")
    try:
        with Image.open(BytesIO(payload), formats=[formats[mime_type]]) as probe:
            width, height = probe.size
            if (width <= 0 or height <= 0 or max(width, height) > MAX_IMAGE_SIDE
                    or width * height > MAX_IMAGE_PIXELS or getattr(probe, "n_frames", 1) != 1):
                raise StorageError("Dimensi gambar terlalu besar atau gambar beranimasi.")
            probe.verify()
        with Image.open(BytesIO(payload), formats=[formats[mime_type]]) as decoded:
            decoded.load()
            oriented = ImageOps.exif_transpose(decoded).convert("RGB")
            clean = Image.new("RGB", oriented.size)
            clean.paste(oriented)
            return clean
    except (UnidentifiedImageError, OSError, SyntaxError, ValueError,
            Image.DecompressionBombError):
        raise StorageError("Gambar rusak atau format tidak sesuai.") from None


def save_camera_image(category: str, payload: bytes, mime_type: str) -> str:
    """Store a lossless recognition sample. Attendance proof uses save_evidence."""

    if category not in {"faces"}:
        raise StorageError("Kategori gambar tidak valid.")
    with validate_camera_image(payload, mime_type) as clean:
        output = BytesIO()
        # Lossless canonical PNG strips EXIF/trailing payload without degrading
        # recognition input. Evidence compression belongs to attendance service.
        clean.save(output, format="PNG")
    return _write(category, "png", output.getvalue())


def save_trained_model(payload: bytes) -> str:
    """Store output produced by the server trainer; NOT an upload interface.

    Model validation/activation and enrollment atomicity are part of T16.
    """
    if not isinstance(payload, bytes) or not 0 < len(payload) <= MAX_MODEL_BYTES:
        raise StorageError("Ukuran model tidak valid.")
    return _write("models", "yml", payload)


def save_evidence(image: Image.Image) -> str:
    """Compress an already-validated face crop into private attendance evidence.

    Recognition runs on the lossless frame first; this write is the compressed
    proof stored per PRD 14.5. Callers delete the key when the transaction fails.
    """

    init_storage()
    root = _private_root()
    key = f"attendance/{uuid.uuid4().hex}.webp"
    destination = root / key
    output = BytesIO()
    image.convert("RGB").save(output, format="WEBP", quality=70, method=4)
    payload = output.getvalue()
    if not 0 < len(payload) <= MAX_IMAGE_BYTES:
        raise StorageError("Ukuran bukti presensi tidak valid.")
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
    return key
