"""Append safe event metadata using the caller's existing transaction."""

from datetime import datetime, timezone
import json


# Explicitly enumerate event types so a route cannot turn audit into an
# arbitrary request logger. Secrets and raw biometric payloads stay out.
AUDIT_ACTIONS = {
    "password_changed": "user",
    "teacher_created": "teacher",
    "teacher_updated": "teacher",
    "teacher_deactivated": "teacher",
    "teacher_password_reset": "teacher",
    "student_created": "student",
    "student_updated": "student",
    "student_deactivated": "student",
    "student_password_reset": "student",
    "academic_year_created": "academic_year",
    "academic_year_activated": "academic_year",
    "academic_year_deactivated": "academic_year",
    "class_created": "class",
    "class_updated": "class",
    "class_deactivated": "class",
    "student_enrollment_created": "student_enrollment",
    "schedule_created": "schedule",
    "schedule_updated": "schedule",
    "schedule_activated": "schedule",
    "schedule_deactivated": "schedule",
    "schedule_exception_created": "schedule_exception",
    "schedule_exception_updated": "schedule_exception",
    "schedule_exception_activated": "schedule_exception",
    "schedule_exception_deactivated": "schedule_exception",
    "geofence_updated": "geofence",
    "face_pose_captured": "student",
    "face_enrollment_completed": "student",
    "face_reset": "student",
    "attendance_checkin": "attendance_record",
    "attendance_checkout": "attendance_record",
    "attendance_alpa_finalized": "attendance_record",
    "attendance_manual_status_set": "attendance_record",
    "attendance_manual_status_corrected": "attendance_record",
    "attendance_manual_status_cancelled": "attendance_record",
}
AUDIT_METADATA_KEYS = {
    "must_change_password",
    "is_active",
    "employee_number_present",
    "nisn_present",
    "face_registered",
    "teacher_assigned",
    "student_id_present",
    "class_id_present",
    "fields",
    "is_late",
    "duplicate",
    "status",
    "previous_status",
}
AUDIT_STATUSES = {None, "present", "late", "permit", "sick", "absent"}
AUDIT_FIELD_NAMES = {"full_name", "employee_number", "nisn", "name", "teacher_id",
                     "day_of_week", "checkin_start", "late_after", "checkin_cutoff",
                     "checkout_start", "exception_date", "scope", "exception_type",
                     "name", "latitude", "longitude", "radius_meters", "max_accuracy_meters",
                     "is_active"}


def record_audit(cursor, *, actor_user_id: int | None, action: str,
                 target_type: str, target_id: int, metadata: dict | None = None) -> int:
    """Insert without commit: business mutation and audit succeed or fail together.

    No free-form values, hashes, request bodies, IPs, or biometric data are
    accepted. A null actor is reserved for future system jobs.
    """
    if action not in AUDIT_ACTIONS or AUDIT_ACTIONS[action] != target_type:
        raise ValueError("Aksi audit belum terdaftar.")
    if actor_user_id is not None and (type(actor_user_id) is not int or actor_user_id <= 0):
        raise ValueError("ID pelaku audit harus bilangan positif.")
    if type(target_id) is not int or target_id <= 0:
        raise ValueError("Target audit tidak valid.")
    metadata = {} if metadata is None else metadata
    if type(metadata) is not dict or set(metadata) - AUDIT_METADATA_KEYS:
        raise ValueError("Metadata audit tidak diizinkan.")
    for key, value in metadata.items():
        if key == "fields":
            if (type(value) is not list or not value
                    or any(item not in AUDIT_FIELD_NAMES for item in value)):
                raise ValueError("Field audit tidak diizinkan.")
        elif key in {"status", "previous_status"}:
            if value is not None and (not isinstance(value, str) or value not in AUDIT_STATUSES):
                raise ValueError("Status audit tidak diizinkan.")
        elif type(value) is not bool:
            raise ValueError("Nilai metadata audit tidak diizinkan.")
    cursor.execute(
        """INSERT INTO audit_logs
           (actor_user_id, action, target_type, target_id, metadata, created_at)
           VALUES (%s, %s, %s, %s, %s, %s)""",
        (actor_user_id, action, target_type, target_id,
         json.dumps(metadata, separators=(",", ":")),
         datetime.now(timezone.utc).replace(tzinfo=None)),
    )
    return int(cursor.lastrowid)
