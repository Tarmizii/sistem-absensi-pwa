"""T14 enrollment gate, progress privacy, and forced-password ordering tests."""

from __future__ import annotations

import unittest
from unittest.mock import patch

from pymysql import MySQLError
from app import create_app
from app.services.auth_service import credential_stamp
from app.services.enrollment_service import get_own_enrollment_progress
from werkzeug.security import generate_password_hash


class _Cursor:
    def __init__(self, student, faces):
        self.student = student
        self.faces = faces
        self.calls = []

    def __enter__(self):
        return self

    def __exit__(self, *_args):
        return False

    def execute(self, query, params):
        self.calls.append((query, params))

    def fetchone(self):
        return self.student

    def fetchall(self):
        return self.faces


class _DB:
    def __init__(self, cursor):
        self._cursor = cursor

    def cursor(self):
        return self._cursor


class StudentEnrollmentTests(unittest.TestCase):
    def _client(self, *, registered=False, must_change=False, role="student", user_id=201):
        app = create_app({"TESTING": True, "SECRET_KEY": "student-enrollment-test"})
        client = app.test_client()
        user = {"id": user_id, "username": f"user-{user_id}",
                "password_hash": generate_password_hash("synthetic-password"),
                "role": role, "is_active": 1, "must_change_password": int(must_change),
                "face_registered": int(registered)}
        with app.app_context(), client.session_transaction() as session:
            session["user_id"] = user_id
            session["credential_stamp"] = credential_stamp(user["password_hash"])
        return app, client, user

    def test_progress_is_scoped_to_current_student_and_never_returns_storage_key(self):
        cursor = _Cursor({"student_id": 44, "face_registered": 0, "full_name": "Siswa Sintetis"},
                         [{"pose": "front"}, {"pose": "right"}])
        with patch("app.services.enrollment_service.get_db", return_value=_DB(cursor)):
            progress = get_own_enrollment_progress(201)
        self.assertEqual(cursor.calls[0][1], (201,))
        self.assertIn("u.id = %s AND u.role = 'student'", cursor.calls[0][0])
        self.assertEqual(cursor.calls[1][1], (44,))
        self.assertEqual(progress["saved_count"], 2)
        self.assertEqual([pose["key"] for pose in progress["poses"] if pose["saved"]], ["front", "right"])
        self.assertFalse(any("storage_key" in row for row in progress["poses"]))

    def test_dashboard_and_student_api_redirect_to_enrollment(self):
        app, client, user = self._client()
        app.add_url_rule("/attendance/today", endpoint="attendance.test_today",
                         view_func=lambda: "must not execute")
        with patch("app.services.auth_service.fetch_active_user", return_value=user):
            dashboard = client.get("/student/dashboard")
            api = client.get("/attendance/today")
        self.assertEqual(dashboard.status_code, 302)
        self.assertEqual(dashboard.headers["Location"], "/student/enrollment")
        self.assertEqual(api.status_code, 302)
        self.assertEqual(api.headers["Location"], "/student/enrollment")

    def test_enrollment_page_shows_three_poses_without_false_success(self):
        app, client, user = self._client()
        progress = {"student_id": 44, "full_name": "Siswa Sintetis", "face_registered": False,
                    "saved_count": 3, "total_poses": 3,
                    "poses": [{"key": key, "label": label, "saved": True} for key, label in
                              (("front", "Depan"), ("left", "Kiri"), ("right", "Kanan"))]}
        with patch("app.services.auth_service.fetch_active_user", return_value=user), \
                patch("app.student.routes.get_own_enrollment_progress", return_value=progress):
            response = client.get("/student/enrollment")
        page = response.get_data(as_text=True)
        self.assertEqual(response.status_code, 200)
        self.assertIn("<span id=\"enrollment-saved-count\">3</span><span aria-hidden=\"true\">/</span>3", page)
        self.assertIn("Pendaftaran belum selesai", page)
        self.assertNotIn("Selesai", page)

    def test_forced_password_change_runs_before_enrollment_redirect(self):
        app, client, user = self._client(must_change=True)
        with patch("app.services.auth_service.fetch_active_user", return_value=user):
            response = client.get("/student/dashboard")
            password_page = client.get("/change-password")
        enrolled_user = user | {"must_change_password": 0}
        with patch("app.services.auth_service.fetch_active_user", return_value=enrolled_user):
            after_password_change = client.get("/student/dashboard")
        self.assertEqual(response.status_code, 302)
        self.assertEqual(response.headers["Location"], "/change-password")
        self.assertEqual(password_page.status_code, 200)
        self.assertEqual(after_password_change.status_code, 302)
        self.assertEqual(after_password_change.headers["Location"], "/student/enrollment")

    def test_other_roles_cannot_open_enrollment_page(self):
        app, client, teacher = self._client(role="teacher", registered=False)
        with patch("app.services.auth_service.fetch_active_user", return_value=teacher):
            response = client.get("/student/enrollment")
        self.assertEqual(response.status_code, 403)

    def test_database_failure_has_a_clear_retry_action(self):
        app, client, user = self._client()
        with patch("app.services.auth_service.fetch_active_user", return_value=user), \
                patch("app.student.routes.get_own_enrollment_progress",
                      side_effect=MySQLError("synthetic unavailable")):
            response = client.get("/student/enrollment")
        self.assertEqual(response.status_code, 503)
        self.assertIn("Progres belum dapat dimuat", response.get_data(as_text=True))
        self.assertIn(">Coba lagi</a>", response.get_data(as_text=True))


if __name__ == "__main__":
    unittest.main()
