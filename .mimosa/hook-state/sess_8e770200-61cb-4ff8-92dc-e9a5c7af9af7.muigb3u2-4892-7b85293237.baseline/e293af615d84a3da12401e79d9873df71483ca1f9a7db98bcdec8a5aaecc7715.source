from pathlib import Path
import json
import re
from PIL import Image

root = Path(__file__).resolve().parents[1]
assets = root / 'design/illustrations/v2'
dimensions = {}
stats = []
for source in sorted(assets.glob('*.png')):
    with Image.open(source) as image:
        # Delivery encoding only: no crop, compositing, recoloring or alpha removal.
        target = root / 'app/static/illustrations' / (source.stem + '.webp')
        image.save(target, 'WEBP', quality=85, method=6)
        assert target.stat().st_size <= 200_000, target
        dimensions[source.stem] = image.size
        stats.append(dict(name=source.stem, width=image.width, height=image.height, bytes=target.stat().st_size))

names = ['school-day', 'welcome', 'attendance', 'enrollment', 'success']
for path in (root / 'app/templates').rglob('*.html'):
    original = path.read_text(encoding='utf-8')
    content = original
    for name in names:
        content = content.replace('illustrations/' + name + '.svg', 'illustrations/' + name + '-v2.webp')
    if path.name == 'dashboard.html' and path.parent.name == 'teacher':
        content = content.replace('illustrations/welcome-v2.webp', 'illustrations/teacher-welcome-v2.webp')
    if path.name == 'role_dashboard.html':
        content = content.replace('illustrations/school-day-v2.webp', 'illustrations/admin-welcome-v2.webp')
    def size_tag(match):
        tag = match.group(0)
        name = re.search(r'illustrations/([a-z-]+-v2)\.webp', tag)
        if name:
            width, height = dimensions[name.group(1)]
            tag = re.sub(r'width="\d+"', f'width="{width}"', tag)
            tag = re.sub(r'height="\d+"', f'height="{height}"', tag)
        return tag
    content = re.sub(r'<img\b[^>]*>', size_tag, content)
    if content != original:
        path.write_text(content, encoding='utf-8')

path = root / 'app/static/service-worker.js'
content = path.read_text(encoding='utf-8').replace('${CACHE_PREFIX}v6', '${CACHE_PREFIX}v7')
for name in names:
    content = content.replace('illustrations/' + name + '.svg', 'illustrations/' + name + '-v2.webp')
content = content.replace('  "/static/illustrations/school-day-v2.webp",', '  "/static/illustrations/school-day-v2.webp",\n  "/static/illustrations/teacher-welcome-v2.webp",\n  "/static/illustrations/admin-welcome-v2.webp",')
path.write_text(content, encoding='utf-8')
(assets / 'sizes.json').write_text(json.dumps(stats, indent=2) + '\n', encoding='utf-8')
print(json.dumps(stats, indent=2))
print('Total WebP bytes:', sum(item['bytes'] for item in stats))
